# Neon connection string from the Neon console. sslmode=require is required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
PD_ENV=production
OLLAMA_HOST=http://127.0.0.1:11434

